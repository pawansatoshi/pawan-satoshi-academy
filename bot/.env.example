# ─────────────────────────────────────────────────────────────
# Pawan Satoshi Academy — Bot Environment Configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Discord Application (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Database (SQLite, default — file path relative to bot/)
DATABASE_PATH=./data/academy.db

# Owner (Discord user ID — always retains full override control)
OWNER_DISCORD_ID=

# Role IDs (filled in after roles are created on the server)
ROLE_ID_ADMIN=
ROLE_ID_MODERATOR=
ROLE_ID_MENTOR=
ROLE_ID_OG=
ROLE_ID_ACTIVE=
ROLE_ID_VERIFIED=
ROLE_ID_MEMBER=

# Key channel IDs (filled in after channels are created)
CHANNEL_ID_WELCOME=
CHANNEL_ID_ANNOUNCEMENTS=
CHANNEL_ID_ACADEMY_HUB=
CHANNEL_ID_QUIZ_ARENA=
CHANNEL_ID_LOGS=
CHANNEL_ID_MOD_LOGS=

# Website (for certificate verification export + links)
WEBSITE_BASE_URL=https://pawansatoshi.github.io/pawan-satoshi-academy

# AI Helper
# Default mode is retrieval-based over academy/ and docs/ content —
# no external API key required. Only set the below if you explicitly
# choose to enable an optional external provider. Never required.
AI_HELPER_MODE=retrieval
AI_HELPER_EXTERNAL_API_KEY=

# Meeting schedule (IST, 24h format)
WEEKLY_MEETING_DAY=SUNDAY
WEEKLY_MEETING_HOUR_IST=19
