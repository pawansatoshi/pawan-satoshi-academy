# Pawan Satoshi Academy — Bot Environment Configuration
# Copy to `.env` and fill in your own values. Never commit the real `.env`.

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

NODE_ENV=development
LOG_LEVEL=info
DATABASE_PATH=./data/academy.db
OWNER_DISCORD_ID=

# Website / certificate API metadata
WEBSITE_BASE_URL=https://pawansatoshi.github.io/pawan-satoshi-academy

# AI helper — retrieval is the default and needs no external key
AI_HELPER_MODE=retrieval
AI_HELPER_EXTERNAL_API_KEY=

# Weekly Academy meeting, IST
WEEKLY_MEETING_DAY=SUNDAY
WEEKLY_MEETING_HOUR_IST=19

# Daily community quiz, IST
DAILY_QUIZ_HOUR_IST=9
DAILY_QUIZ_COUNT=1
